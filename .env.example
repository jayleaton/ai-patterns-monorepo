# Database
# TLS is controlled by the URL: hosted Postgres (Neon/Supabase) uses
# `?sslmode=require`; local Docker stays plain. The API always reaches the
# database server-side, so keep this on localhost for local dev even when
# the app itself is reached over Tailscale/LAN.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/better-stack

# Host port for the docker compose Postgres/pgweb containers
# (override in .env when 5432/5050 are taken by other projects)
# POSTGRES_PORT=5432
# PGWEB_PORT=5050

# Better Auth
AUTH_SECRET=replace-with-a-strong-secret-of-32-chars-min
NEXT_PUBLIC_URL=http://localhost:3000

# Optional: server-to-self fetch target (defaults to NEXT_PUBLIC_URL)
# INTERNAL_URL=http://127.0.0.1:3000

# Extra hosts to allow in development (comma-separated hostnames or IPs)
# DEV_ALLOWED_ORIGINS=dev-box,macbook

# Resend
RESEND_API_KEY=replace-with-your-resend-key
FROM_EMAIL=noreply@example.com
