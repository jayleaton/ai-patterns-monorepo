{
  "name": "web-app",
  "version": "1.0.0",
  "description": "Next.js web app",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "test": "cd ../.. && vitest run",
    "db:generate": "cd ../../packages/database && pnpm db:generate",
    "db:migrate": "cd ../../packages/database && pnpm db:migrate",
    "db:push": "cd ../../packages/database && pnpm db:push",
    "db:studio": "cd ../../packages/database && pnpm db:studio",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@better-stack-monorepo/common": "workspace:*",
    "@better-stack-monorepo/database": "workspace:*",
    "@better-auth/expo": "1.6.29",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/ms": "^2.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "better-auth": "^1.6.29",
    "clsx": "^2.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "ms": "^2.1.3",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.2",
    "react-icons": "^5.7.0",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "vitest": "^4.1.10"
  }
}