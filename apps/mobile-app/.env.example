# Copy to .env.local and adjust for your device.
#
# Base URL of the web app's API (apps/web-app). Inlined at bundle time —
# restart `expo start` after changing it.
#
# iOS Simulator:      http://localhost:3000
# Android Emulator:   http://10.0.2.2:3000
# Physical device:    your LAN IP or Tailscale hostname,
#                     e.g. http://my-mac.tailnet.ts.net:3000
#
# Never point this at a bare `localhost` when testing on a real device — the
# phone resolves localhost to itself, not to your dev machine.
EXPO_PUBLIC_API_URL=http://localhost:3000
